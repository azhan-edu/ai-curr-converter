generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ConversionHistory {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  amount       Float
  result       Float
  rate         Float
  timestamp    DateTime @default(now())

  @@index([timestamp])
  @@map("conversion_history")
}