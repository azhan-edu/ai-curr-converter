# Rates cache TTL in seconds.
# Set to 0 to bypass cache and always fetch fresh rates.
RATES_CACHE_TTL_SECONDS=3600

# Debounce delay (ms) before conversion executes while typing amount input.
# Default is 800ms (0.8 seconds).
NEXT_PUBLIC_CONVERSION_INPUT_DEBOUNCE_MS=800

# Prisma SQLite database URL.
DATABASE_URL="file:./dev.db"
